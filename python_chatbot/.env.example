# TenaWise AI Chatbot Environment Variables
# Get a free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: 'auto' (tries Ollama first, falls back to Gemini), 'ollama', or 'gemini'
LLM_PROVIDER=auto

# Ollama local server settings (used when LLM_PROVIDER is 'auto' or 'ollama')
# Install Ollama from https://ollama.com then run: ollama pull qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

PORT=8000
